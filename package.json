{
  "name": "@mir-ui/reswap",
  "version": "0.1.0",
  "description": "Accessible animated text replacement for React with grapheme-safe segmentation, measured height, and named timing groups.",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "keywords": [
    "react",
    "animation",
    "text",
    "motion",
    "accessibility"
  ],
  "files": [
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "llms.txt"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./legacy": {
      "types": "./dist/legacy.d.ts",
      "import": "./dist/legacy.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "vite build --config vite.config.ts && tsc -p tsconfig.build.json",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "motion": ">=12",
    "react": ">=18"
  },
  "devDependencies": {
    "@types/node": ">=22",
    "@types/react": ">=18",
    "@types/react-dom": ">=18",
    "@testing-library/react": ">=16",
    "jsdom": "^26.1.0",
    "motion": ">=12",
    "react": ">=18",
    "react-dom": ">=18",
    "typescript": ">=5.7",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
